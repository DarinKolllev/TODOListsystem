@model IEnumerable<Note>

@{
    ViewData["Title"] = "My Tasks";
}

<section class="tasks-shell">
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <p class="text-muted mb-1">Your productivity board</p>
        <h1 class="mb-0">My Tasks</h1>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <div class="input-group input-group-sm tasks-toolbar-control">
            <input type="text" id="taskSearch" class="form-control" placeholder="Search tasks..." onkeyup="filterTasks()">
            <span class="input-group-text">Search</span>
        </div>
        <select id="typeFilter" class="form-select form-select-sm tasks-toolbar-filter" onchange="filterTasks()">
            <option value="all">All Types</option>
            @foreach (var type in Enum.GetValues(typeof(TODOlistsystem.Models.TaskType)))
            {
                <option value="@type">@type</option>
            }
        </select>
        <a asp-action="Create" class="btn btn-primary">+ Create Task</a>
    </div>
</div>

<div class="row g-4" id="taskGrid">
    @foreach (var item in Model)
    {
        <div class="col-12 col-md-6 col-lg-4 task-card" data-content="@item.Content.ToLower()" data-type="@item.Type">
            <div class="card glass-panel task-card-surface h-100 @(item.IsCompleted ? "border-success opacity-75" : "")">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="d-flex flex-wrap gap-1">
                            @{
                                var badgeClass = item.Type switch
                                {
                                    TODOlistsystem.Models.TaskType.Work => "bg-primary",
                                    TODOlistsystem.Models.TaskType.Fitness => "bg-success",
                                    TODOlistsystem.Models.TaskType.Reading => "bg-info text-dark",
                                    TODOlistsystem.Models.TaskType.Personal => "bg-warning text-dark",
                                    TODOlistsystem.Models.TaskType.Health => "bg-teal",
                                    TODOlistsystem.Models.TaskType.Challenge => "bg-danger",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass">
                                @item.Type
                            </span>
                            <span class="badge @(item.Priority == TODOlistsystem.Models.TaskPriority.Urgent ? "bg-danger" : (item.Priority == TODOlistsystem.Models.TaskPriority.High ? "bg-warning text-dark" : "bg-light text-dark"))">
                                @item.Priority
                            </span>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" @(item.IsCompleted ? "checked" : "") onchange="toggleTask('@item.Id', this)">
                        </div>
                    </div>
                    
                    <h5 class="card-title text-main @(item.IsCompleted ? "text-decoration-line-through text-muted" : "")">@Html.DisplayFor(modelItem => item.Content)</h5>
                    
                    <div class="mt-auto pt-3">
                        @if(item.DueDate.HasValue)
                        {
                            <p class="card-text text-muted small mb-3">
                                <i class="bi bi-calendar-event"></i> Due: @item.DueDate.Value.ToString("MMM dd, yyyy HH:mm")
                            </p>
                        }
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                            </div>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
</section>

@section Scripts {
    <script>
        function filterTasks() {
            const search = document.getElementById('taskSearch').value.toLowerCase();
            const type = document.getElementById('typeFilter').value;
            const cards = document.querySelectorAll('.task-card');
            
            cards.forEach(card => {
                const content = card.getAttribute('data-content');
                const cardType = card.getAttribute('data-type');
                
                const matchesSearch = content.includes(search);
                const matchesType = type === 'all' || cardType === type;
                
                if (matchesSearch && matchesType) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        async function toggleTask(id, checkbox) {
            try {
                const response = await fetch(`/Notes/ToggleComplete/${id}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ""
                    }
                });
                
                if (response.ok) {
                    const data = await response.json();
                    checkbox.checked = data.isCompleted;
                    location.reload(); // Simple way to update UI classes and Points
                } else {
                    checkbox.checked = !checkbox.checked; // Revert on error
                }
            } catch (error) {
                console.error('Error toggling task:', error);
                checkbox.checked = !checkbox.checked;
            }
        }
    </script>
}
