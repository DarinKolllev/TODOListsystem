@using TODOlistsystem
@using TODOlistsystem.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Home";
}

<div class="container py-4 pb-lg-5 text-center hero-section mt-3 mb-2">
    <div class="d-inline-flex align-items-center py-1 px-3 rounded-pill bg-primary bg-opacity-10 text-primary fw-semibold mb-4" style="font-family: 'Outfit'; font-size: 0.9rem;">
        <span class="me-2">✨</span> 
        The Ultimate Productivity Tool
    </div>
    <h1 class="display-3 fw-bolder mb-4" style="letter-spacing: -1px;">
        Manage Your Tasks <br/>
        <span class="text-gradient">With Extraordinary Ease</span>
    </h1>
    <p class="lead text-muted mb-5 mx-auto" style="max-width: 600px; font-size: 1.15rem; line-height: 1.7;">
        Transform your daily chaos into organized success. Seamlessly plan your schedule, add events, and stay productive.
    </p>
    @if (User?.Identity?.IsAuthenticated != true) {
        <div class="mb-5 d-flex justify-content-center gap-3">
            <a class="btn btn-primary btn-lg px-5 py-3" style="border-radius: 50px;" asp-area="Identity" asp-page="/Account/Register">Get Started Free</a>
            <a class="btn btn-outline-secondary btn-lg px-5 py-3" style="border-radius: 50px;" asp-area="Identity" asp-page="/Account/Login">Sign In</a>
        </div>
    }
</div>

<div class="row justify-content-center mb-5 pb-5">
    <div class="col-lg-11 col-xl-10">
        <div class="glass-panel p-1">
            <div class="card shadow-none border-0 m-0 w-100" style="border-radius: 18px;">
                <div class="card-body p-4 p-md-5">
                    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                        <h3 class="card-title fw-bold m-0" style="font-family: 'Outfit'">Your Schedule</h3>
                        <span class="badge bg-primary bg-opacity-10 text-primary py-2 px-3 rounded-pill" style="font-size: 0.85rem;">Live View</span>
                    </div>
                    <div id="calendar"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var calendarEl = document.getElementById('calendar');

            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: window.innerWidth <= 768 ? 'listWeek' : 'dayGridMonth',
                height: window.innerWidth <= 768 ? 'auto' : 500,
                selectable: true,
                events: '/Home/GetEvents',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,listWeek'
                },

                dateClick: function(info) {
                    var title = prompt("Enter event title:");
                    if (title) {
                        fetch('/Home/AddEvent', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                title: title,
                                start: info.dateStr
                            })
                        }).then(() => {
                            calendar.refetchEvents();
                        });
                    }
                }
            });

            calendar.render();

            window.addEventListener('resize', function() {
                if(window.innerWidth <= 768) {
                    calendar.changeView('listWeek');
                    calendar.setOption('height', 'auto');
                } else {
                    calendar.changeView('dayGridMonth');
                    calendar.setOption('height', 500);
                }
            });
        });
    </script>
}