<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TaskFlow</title>
    <base href="~/" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TODOlistsystem.styles.css" asp-append-version="true" />
</head>

<body class="app-body">
    <header>
        <nav class="navbar navbar-expand-lg sticky-top app-navbar">
            <div class="container">
                <a class="navbar-brand fw-bold app-brand" asp-controller="Home" asp-action="Index">
                    TaskFlow
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">

                    <ul class="navbar-nav me-auto app-nav-links">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Notes" asp-action="Index">
                                Tasks
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2 ms-auto">
                        <button type="button" id="themeToggle" class="btn btn-sm btn-outline-secondary theme-toggle-btn" aria-label="Toggle theme">
                            Dark mode
                        </button>
                        <partial name="_LoginPartial" />
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <div class="container app-main-container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer app-footer text-muted mt-5">
        <div class="container text-center py-3">
            &copy; 2026 - TaskFlow. Stay focused, ship daily.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>