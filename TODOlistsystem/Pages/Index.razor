@page "/"
@inject TODOlistsystem.Data.ApplicationDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@using TODOlistsystem.Models
@using Microsoft.EntityFrameworkCore
@using System

<PageTitle>Home</PageTitle>

<div class="container py-4 pb-lg-5 text-center hero-section mt-3 mb-2">
    <div class="d-inline-flex align-items-center py-1 px-3 text-muted fw-semibold mb-3 text-uppercase" style="font-family: 'Inter'; font-size: 0.8rem; letter-spacing: 0.1em; border: 1px solid var(--card-border);">
        <svg width="14" height="14" fill="currentColor" class="me-2" viewBox="0 0 16 16"><path d="M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0zm1.5 4.5a.5.5 0 0 0-1 0v3.793L6.146 10.146a.5.5 0 1 0 .708.708l2.5-2.5a.5.5 0 0 0 .146-.354V4.5z"/></svg> 
        Executive Task Management
    </div>
    <h1 class="display-4 fw-bold mb-4" style="letter-spacing: -1px;">
        Command Your Schedule <br/>
        <span class="text-gradient">With Precision</span>
    </h1>
    <p class="lead text-muted mb-5 mx-auto" style="max-width: 600px; font-size: 1.1rem; line-height: 1.6;">
        A robust platform to orchestrate your daily agenda, ensuring rigorous organization and peak efficiency.
    </p>
    <AuthorizeView>
        <NotAuthorized>
            <div class="mb-5 d-flex justify-content-center gap-3">
                <a class="btn btn-primary px-4 py-2" href="/Identity/Account/Register">Get Started Free</a>
                <a class="btn btn-outline-secondary px-4 py-2" href="/Identity/Account/Login">Sign In</a>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

<div class="row justify-content-center mb-5 pb-5">
    <!-- Pure C# Blazor Calendar -->
    <div class="col-lg-8 mb-4">
        <div class="glass-panel p-1 h-100">
            <div class="card shadow-none border-0 m-0 w-100 h-100" style="border-radius: 18px;">
                <div class="card-body p-4 p-md-5">
                    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                        <h3 class="card-title fw-bold m-0" style="font-family: 'Outfit'">Your Schedule (Pure C#)</h3>
                        <span class="badge bg-primary bg-opacity-10 text-primary py-2 px-3 rounded-pill" style="font-size: 0.85rem;">Live View</span>
                    </div>

                    <div class="calendar-container">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <button class="btn btn-outline-secondary btn-sm" @onclick="PrevMonth">Previous</button>
                            <h5 class="m-0 fw-bold">@CalendarDate.ToString("MMMM yyyy")</h5>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="NextMonth">Next</button>
                        </div>
                        
                        <div class="calendar-grid">
                            <div class="calendar-header-row text-muted fw-bold pb-2 border-bottom mb-2" style="display: grid; grid-template-columns: repeat(7, 1fr); text-align: center; text-transform: uppercase; font-size: 0.8rem;">
                                <div>Sun</div><div>Mon</div><div>Tue</div><div>Wed</div><div>Thu</div><div>Fri</div><div>Sat</div>
                            </div>
                            <div class="calendar-body" style="display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px;">
                                @foreach(var day in GetDaysInMonth())
                                {
                                    var isToday = day.Date == DateTime.Today;
                                    var isOtherMonth = day.Month != CalendarDate.Month;
                                    var dayClass = "calendar-day p-2 rounded " + (isToday ? "bg-primary bg-opacity-25 border border-primary " : "bg-dark bg-opacity-10 border border-secondary border-opacity-25 ") + (isOtherMonth ? "opacity-50" : "");
                                    var dayEvents = AllEvents.Where(e => e.DueDate?.Date == day.Date).ToList();
                                    
                                    <div class="@dayClass" style="min-height: 80px; display: flex; flex-direction: column;">
                                        <div class="text-end fw-bold mb-1" style="font-size: 0.8rem;">@day.Day</div>
                                        <div class="events-list d-flex flex-column gap-1 overflow-hidden">
                                            @foreach(var evt in dayEvents)
                                            {
                                                var bgi = evt.IsCompleted ? "bg-secondary" : "bg-primary";
                                                var dec = evt.IsCompleted ? "text-decoration-line-through" : "";
                                                <div class="rounded px-1 text-white @bgi @dec text-truncate" style="font-size: 0.7rem;" title="@evt.Content">@evt.Content</div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
    
    <div class="col-lg-4 mb-4">
        <div class="glass-panel p-1 h-100">
            <div class="card shadow-none border-0 m-0 w-100 h-100" style="border-radius: 18px; display: flex; flex-direction: column;">
                <div class="card-body p-4 p-md-5" style="display: flex; flex-direction: column; flex-grow: 1;">
                    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                        <h3 class="card-title fw-bold m-0" style="font-family: 'Outfit'">Daily Tasks</h3>
                        <span class="badge bg-secondary bg-opacity-10 text-secondary py-2 px-3 rounded-pill" style="font-size: 0.85rem;">@(Tasks?.Count ?? 0) Tasks</span>
                    </div>
                    
                    <AuthorizeView>
                        <Authorized>
                            <div class="input-group mb-4 shadow-sm" style="border-radius: 12px; overflow: hidden;">
                                <input type="text" @bind="NewTaskContent" @bind:event="oninput" @onkeyup="HandleKeyUp" class="form-control border-0" placeholder="Add a new daily task..." aria-label="New task">
                                <button class="btn btn-primary px-4" type="button" @onclick="AddTask" style="border-radius: 0;">Add</button>
                            </div>
                            <div class="tasks-container" style="flex-grow: 1; overflow-y: auto; max-height: 400px; padding-right: 5px;">
                                <ul class="list-group list-group-flush">
                                    @if (Tasks == null)
                                    {
                                        <li class="list-group-item text-center text-muted border-0 py-4"><div class="spinner-border text-primary spinner-border-sm" role="status"></div> Loading...</li>
                                    }
                                    else if (Tasks.Count == 0)
                                    {
                                        <li class="list-group-item text-center text-muted border-0 py-4">No tasks for today. Outstanding!</li>
                                    }
                                    else
                                    {
                                        @foreach (var task in Tasks)
                                        {
                                            var isChecked = task.IsCompleted;
                                            var textClass = isChecked ? "text-decoration-line-through text-muted" : "text-main";

                                            <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 mb-2 rounded bg-transparent">
                                                <div class="d-flex align-items-center gap-3 w-100 p-3 task-item-container mb-1">
                                                    <input class="form-check-input flex-shrink-0 mt-0" type="checkbox" style="width: 1.25em; height: 1.25em; cursor: pointer; background-color: var(--input-bg); border-color: var(--card-border);" checked="@isChecked" @onchange="() => ToggleTask(task)" />
                                                    <span class="text-truncate flex-grow-1 @textClass" style="cursor: pointer; font-weight: 500;" @onclick="() => ToggleTask(task)">@task.Content</span>
                                                    <button class="btn btn-sm btn-link text-danger p-0 ms-2 flex-shrink-0" @onclick="() => DeleteTask(task)">
                                                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/><path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/></svg>
                                                    </button>
                                                </div>
                                            </li>
                                        }
                                    }
                                </ul>
                            </div>
                        </Authorized>
                        <NotAuthorized>
                            <div class="text-center py-5">
                                <h5 class="text-muted fw-normal mb-3">Sign in to manage your daily tasks</h5>
                                <a class="btn btn-outline-secondary" href="/Identity/Account/Login">Sign In</a>
                            </div>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Note> Tasks = null;
    private List<Note> AllEvents = new List<Note>();
    private string NewTaskContent = "";
    private string UserId;

    private DateTime CalendarDate = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            var appUser = await UserManager.GetUserAsync(user);
            if (appUser != null)
            {
                UserId = appUser.Id;
                await LoadData();
            }
        }
    }

    private async Task LoadData()
    {
        if (string.IsNullOrEmpty(UserId)) return;
        var today = DateTime.UtcNow.Date;
        
        // Load Daily Tasks
        Tasks = await DbContext.Notes
            .Where(n => n.UserId == UserId && n.DueDate != null && n.DueDate.Value.Date == today && !n.IsDeleted)
            .OrderBy(n => n.IsCompleted)
            .ThenByDescending(n => n.CreatedAt)
            .ToListAsync();

        // Load All Events for Calendar
        AllEvents = await DbContext.Notes
            .Where(n => n.UserId == UserId && n.DueDate != null && !n.IsDeleted)
            .ToListAsync();
    }

    private async Task AddTask()
    {
        if (string.IsNullOrWhiteSpace(NewTaskContent) || string.IsNullOrEmpty(UserId)) return;

        var note = new Note
        {
            Content = NewTaskContent.Trim(),
            DueDate = DateTime.UtcNow.Date,
            UserId = UserId
        };
        DbContext.Notes.Add(note);
        await DbContext.SaveChangesAsync();
        NewTaskContent = "";
        
        await LoadData();
    }

    private async Task ToggleTask(Note task)
    {
        task.IsCompleted = !task.IsCompleted;
        DbContext.Update(task);
        await DbContext.SaveChangesAsync();
        await LoadData(); // Refresh UI and calendar completion states
    }

    private async Task DeleteTask(Note task)
    {
        task.IsDeleted = true;
        DbContext.Update(task);
        await DbContext.SaveChangesAsync();
        await LoadData();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddTask();
        }
    }

    // Pure C# Calendar Logic
    private void PrevMonth()
    {
        CalendarDate = CalendarDate.AddMonths(-1);
    }

    private void NextMonth()
    {
        CalendarDate = CalendarDate.AddMonths(1);
    }

    private List<DateTime> GetDaysInMonth()
    {
        var days = new List<DateTime>();
        var firstDayOfMonth = new DateTime(CalendarDate.Year, CalendarDate.Month, 1);
        var firstDayOfGrid = firstDayOfMonth.AddDays(-(int)firstDayOfMonth.DayOfWeek);
        
        for (int i = 0; i < 42; i++) // 6 weeks * 7 days
        {
            days.Add(firstDayOfGrid.AddDays(i));
        }
        return days;
    }
}
